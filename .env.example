# Copia a .env para desarrollo local. En Vercel: Project Settings → Environment Variables.
# Destino de leads (contacto y conferencias)
LEAD_WEBHOOK_URL=
# Destino de suscripciones a Builder Drops (opcional; si falta usa LEAD_WEBHOOK_URL)
NEWSLETTER_WEBHOOK_URL=
# Destino de leads del Diagnóstico de clínicas (opcional; si falta usa LEAD_WEBHOOK_URL)
DIAGNOSTIC_WEBHOOK_URL=
# Destino de leads del checklist ¿La IA recomienda tu negocio? (opcional; si falta usa LEAD_WEBHOOK_URL)
AI_CHECKLIST_WEBHOOK_URL=
# Secreto opcional enviado como X-Webhook-Secret
LEAD_WEBHOOK_SECRET=
# true = modo prueba (no envía nada, la UI lo indica)
FORMS_DRY_RUN=true
# true solo en previews para revisar borradores
PUBLIC_SHOW_DRAFTS=

# Guillotina Waiver Analyzer. Define en Production de Vercel.
# Contraseña del usuario german. Solo servidor.
NBAFANTASY_ADMIN_PASSWORD=
# Credenciales REST de Upstash Redis para guardar reportes por temporada y semana.
NBAFANTASY_REDIS_URL=
NBAFANTASY_REDIS_TOKEN=
