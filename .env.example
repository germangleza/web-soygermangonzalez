# Copia a .env para desarrollo local. En Vercel: Project Settings → Environment Variables.
# Destino de leads (contacto y conferencias)
LEAD_WEBHOOK_URL=
# Destino de suscripciones a Builder Drops (opcional; si falta usa LEAD_WEBHOOK_URL)
NEWSLETTER_WEBHOOK_URL=
# Secreto opcional enviado como X-Webhook-Secret
LEAD_WEBHOOK_SECRET=
# true = modo prueba (no envía nada, la UI lo indica)
FORMS_DRY_RUN=true
# true solo en previews para revisar borradores
PUBLIC_SHOW_DRAFTS=
