---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
---
<BaseLayout title="Página no encontrada" noindex={true}>
  <PageHero eyebrow="Error 404" title="No encontramos esta página.">
    <p>Puede que el enlace haya cambiado.</p>
    <div class="actions">
      <a class="btn" href="/">Volver al inicio</a>
      <a class="btn btn--outline" href="/builder-lab">Ir a Builder Lab</a>
    </div>
  </PageHero>
</BaseLayout>
