---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import TwoPaths from '../components/sections/TwoPaths.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import TeamBuilders from '../components/sections/TeamBuilders.astro';
import BuilderLabTeaser from '../components/sections/BuilderLabTeaser.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import ClinicDiagnosticCTA from '../components/sections/ClinicDiagnosticCTA.astro';
import { SITE } from '../config/site.config';
---
<BaseLayout fullTitle={SITE.title} description={SITE.description}>
  <HomeHero />
  <TwoPaths />
  <MethodSteps />
  <TeamBuilders />
  <AboutTeaser />
  <BuilderLabTeaser />
  <ClinicDiagnosticCTA />
  <section class="section" aria-label="Siguiente paso">
    <div class="container">
      <CTABanner eyebrow="Opportunity Session" title="¿Qué oportunidad estás viendo?" ctaLabel="Cuéntame tu reto" ctaHref="/contacto">
        <p>Puede ser una necesidad de marketing, web o IA. Una oportunidad de crecimiento. O una idea que todavía no sabes cómo convertir en negocio. Empecemos por entenderla y decidir qué vale la pena construir.</p>
      </CTABanner>
    </div>
  </section>
</BaseLayout>
