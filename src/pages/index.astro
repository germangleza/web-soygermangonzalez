---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import TwoPaths from '../components/sections/TwoPaths.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import TeamBuilders from '../components/sections/TeamBuilders.astro';
import BuilderLabTeaser from '../components/sections/BuilderLabTeaser.astro';
import HomeFAQ from '../components/sections/HomeFAQ.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import { SITE, whatsappUrl } from '../config/site.config';
---
<BaseLayout fullTitle={SITE.title} description={SITE.description}>
  <HomeHero />
  <TwoPaths />
  <MethodSteps />
  <TeamBuilders />
  <AboutTeaser />
  <section class="section" aria-label="Siguiente paso">
    <div class="container">
      <CTABanner eyebrow="Opportunity Session" title="En una llamada sin costo identificamos qué conviene hacer primero." ctaLabel="Agenda tu Opportunity Session" ctaHref="/llamada" secondary={{ label: 'Prefiero escribirte', href: whatsappUrl() || '/contacto' }}>
        <p>Cuéntame en qué está tu negocio, qué te preocupa y dónde estás atorado. De ahí salen las acciones que más pueden mover tus ventas.</p>
      </CTABanner>
    </div>
  </section>
  <BuilderLabTeaser />
  <HomeFAQ />
</BaseLayout>
