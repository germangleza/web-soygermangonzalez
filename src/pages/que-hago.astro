---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import { ENTRY_PATHS, SERVICE_GROUPS, COMMERCIAL_MODEL, SECTORS, SERVICE_FAQS } from '../data/content';
---
<BaseLayout
  fullTitle="Qué hago: growth, IA y nuevos negocios por sprints | Germán González"
  description="Estrategia y ejecución por sprints de 2 a 4 semanas: growth digital, IA y automatización, nuevos negocios y sistemas comerciales. Negocios en todo México."
>
  <FAQSchema faqs={SERVICE_FAQS} />

  <PageHero eyebrow="Qué hago" title="Estrategia y ejecución, según lo que tu negocio necesite." breadcrumbs={[{ name: 'Qué hago', url: '/que-hago' }]}>
    <p>No vendo paquetes. Entiendo el reto, decido qué capacidades activar y lo construimos con el equipo correcto.</p>
    <div class="actions"><a class="btn" href="/contacto">Cuéntame tu reto <span class="btn__icon" aria-hidden="true">↗</span></a></div>
  </PageHero>

  <section class="section" aria-labelledby="puntos-title">
    <div class="container">
      <SectionHeading id="puntos-title" eyebrow="Punto de partida" title="¿En qué punto estás?" />
      <div class="paths">
        {ENTRY_PATHS.map((p, i) => (
          <article class:list={['card path', { 'card--dark': i === 1 }]} id={p.id} data-interes={p.interes}>
            <div class="path__head">
              <span class="card__kicker">{p.kicker}</span>
              <h3>{p.title}</h3>
            </div>
            <div>
              <p class="path__label">Te va a servir si…</p>
              <ul class="path__signals" role="list">
                {p.signals.map((s) => <li>{s}</li>)}
              </ul>
              <p class="path__label">Normalmente activamos</p>
              <ul class="tags" role="list">{p.activates.map((a) => <li>{a}</li>)}</ul>
              <a class="link-arrow path__cta" href={p.cta.href}>{p.cta.label} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="capacidades-title">
    <div class="container">
      <SectionHeading id="capacidades-title" eyebrow="Capacidades" title="Qué incluye cada capacidad y quién la ejecuta.">
        <p class="lead">No son paquetes cerrados: el alcance se decide después de entender el reto. Yo dirijo la estrategia; la ejecución la hacen equipos especializados.</p>
      </SectionHeading>
      <ul class="caps" role="list">
        {SERVICE_GROUPS.map((g, i) => (
          <li class="caps__row">
            <span class="caps__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{g.href ? <a href={g.href}>{g.title} <span aria-hidden="true" class="text-sky">↗</span></a> : g.title}</h3>
            <p>{g.text}</p>
            <span class="caps__who">{g.who}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark dark" aria-labelledby="modelo-title">
    <div class="container">
      <SectionHeading id="modelo-title" eyebrow="Modelo de trabajo" title="Trabajo por sprints.">
        <p class="lead">Cada sprint dura de 2 a 4 semanas y tiene acciones y entregables definidos desde el inicio.</p>
      </SectionHeading>
      <ol class="grid grid-4 model" role="list">
        {COMMERCIAL_MODEL.map((m, i) => (
          <li class="card card--on-dark">
            <span class="card__kicker">{String(i + 1).padStart(2, '0')}{m.optional && ' · Cuando aplique'}</span>
            <h3>{m.step}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="sectores-title">
    <div class="container">
      <SectionHeading id="sectores-title" eyebrow="Sectores" title="Donde más trabajo.">
        <p class="lead">Negocios en cualquier parte de México.</p>
      </SectionHeading>
      <ul class="grid grid-3 sectors" role="list">
        {SECTORS.map((s) => (
          <li class:list={['card', { 'card--dark': s.featured }]}>
            {s.featured && <span class="card__kicker">Especialidad</span>}
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.link && <div class="card__footer"><a class="link-arrow" href={s.link.href}>{s.link.label} <span aria-hidden="true">↗</span></a></div>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <SectionHeading id="faq-title" eyebrow="Preguntas frecuentes" title="Lo que normalmente me preguntan." />
      <div class="faq">
        {SERVICE_FAQS.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CTABanner title="¿Qué quieres resolver?" ctaLabel="Agenda tu Opportunity Session" ctaHref="/contacto">
        <p>Una necesidad concreta o una oportunidad abierta. Empecemos por conocer tu negocio.</p>
      </CTABanner>
    </div>
  </section>
</BaseLayout>

<script>
  // Preserva el contexto de la home (?interes=...) resaltando el bloque correspondiente.
  const interes = new URLSearchParams(location.search).get('interes');
  if (interes) document.querySelector(`[data-interes="${CSS.escape(interes)}"]`)?.classList.add('block--focus');
</script>

<style>
  .paths { display: grid; gap: 1.25rem; }
  .path { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 2rem 3rem; scroll-margin-top: calc(var(--header-h) + 24px); }
  .path h3 { font-size: clamp(1.6rem, 1.25rem + 1.2vw, 2.25rem); margin: 0; }
  .path__label { font-family: var(--font-display); font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .75rem; }
  .card--dark .path__label { color: #fff !important; }
  .path__signals { list-style: none; padding: 0; margin: 0 0 1.75rem; display: grid; gap: .6rem; }
  .path__signals li { position: relative; padding-left: 1.6rem; color: var(--muted); }
  .card--dark .path__signals li { color: var(--muted-on-dark); }
  .path__signals li::before { content: '✓'; position: absolute; left: 0; color: var(--sky); font-weight: 700; }
  .tags { list-style: none; padding: 0; margin: 0 0 1.75rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .tags li { font-size: .875rem; font-weight: 600; padding: .35rem .8rem; border-radius: 99px; border: 1px solid var(--line); }
  .card--dark .tags li { border-color: var(--line-dark); color: #fff; }
  .card--dark .path__cta { color: var(--sky); }
  .block--focus { outline: 3px solid var(--sky); outline-offset: 4px; }

  .caps { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .caps__row { display: grid; grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, .9fr); gap: 1.5rem; align-items: baseline; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .caps__num { font-family: var(--font-display); font-weight: 700; color: var(--sky); }
  .caps h3 { margin: 0; font-size: clamp(1.2rem, 1.05rem + .5vw, 1.45rem); }
  .caps h3 a { color: inherit; text-decoration: none; }
  .caps h3 a:hover { text-decoration: underline; }
  .caps p { margin: 0; color: var(--muted); }
  .caps__who { font-size: .875rem; font-weight: 600; justify-self: end; text-align: right; }

  .model, .sectors { list-style: none; padding: 0; }

  .faq-wrap { max-width: 56rem; }
  .faq { border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); padding: 1.15rem 0; }
  .faq summary { cursor: pointer; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--sky); font-size: 1.4rem; line-height: 1; transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { margin: .75rem 0 0; color: var(--muted); max-width: 46rem; }

  @media (max-width: 1023px) {
    .path { grid-template-columns: minmax(0, 1fr); }
    .caps__row { grid-template-columns: 2.5rem minmax(0, 1fr); gap: .35rem 1rem; }
    .caps__row p, .caps__who { grid-column: 2; }
    .caps__who { justify-self: start; text-align: left; }
  }
</style>
