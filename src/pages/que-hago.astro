---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import { SERVICE_GROUPS, SECTORS } from '../data/content';
---
<BaseLayout
  fullTitle="Qué hago: growth, IA y nuevos negocios por sprints | Germán González"
  description="Estrategia y ejecución por sprints de 2 a 4 semanas: growth digital, IA y automatización, nuevos negocios y sistemas comerciales. Negocios en todo México."
>
  <PageHero eyebrow="Qué hago" title="Estrategia y ejecución, según lo que tu negocio necesite." breadcrumbs={[{ name: 'Qué hago', url: '/que-hago' }]}>
    <p>No vendo paquetes. Entiendo el reto, decido qué capacidades activar y lo construimos con el equipo correcto.</p>
    <div class="actions"><a class="btn" href="/contacto">Cuéntame tu reto <span class="btn__icon" aria-hidden="true">↗</span></a></div>
  </PageHero>

  <section class="section section--alt" aria-labelledby="capacidades-title">
    <div class="container">
      <SectionHeading id="capacidades-title" eyebrow="Capacidades" title="Qué incluye cada capacidad y quién la ejecuta.">
        <p class="lead">No son paquetes cerrados: el alcance se decide después de entender el reto. Yo dirijo la estrategia; la ejecución la hacen equipos especializados.</p>
      </SectionHeading>
      <ul class="caps" role="list">
        {SERVICE_GROUPS.map((g, i) => (
          <li class="caps__row">
            <span class="caps__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{g.href ? <a href={g.href}>{g.title} <span aria-hidden="true" class="text-sky">↗</span></a> : g.title}</h3>
            <p>{g.text}</p>
            <span class="caps__who">{'whoUrl' in g && g.whoUrl ? <a href={g.whoUrl} target="_blank" rel="noopener">{g.who} <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a> : g.who}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="sectores-title">
    <div class="container">
      <SectionHeading id="sectores-title" eyebrow="Sectores" title="Donde más trabajo.">
        <p class="lead">Negocios en cualquier parte de México.</p>
      </SectionHeading>
      <ul class="grid grid-3 sectors" role="list">
        {SECTORS.map((s) => (
          <li class:list={['card', { 'card--dark': s.featured }]}>
            {s.featured && <span class="card__kicker">Especialidad</span>}
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.link && <div class="card__footer"><a class="link-arrow" href={s.link.href}>{s.link.label} <span aria-hidden="true">↗</span></a></div>}
          </li>
        ))}
      </ul>
    </div>
  </section>


  <section class="section">
    <div class="container">
      <CTABanner title="¿Qué quieres resolver?" ctaLabel="Agenda tu Sesión de oportunidades" ctaHref="/contacto">
        <p>Una necesidad concreta o una oportunidad abierta. Empecemos por conocer tu negocio.</p>
      </CTABanner>
    </div>
  </section>
</BaseLayout>

<style>
  .caps { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .caps__row { display: grid; grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, .9fr); gap: 1.5rem; align-items: baseline; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .caps__num { font-family: var(--font-display); font-weight: 700; color: var(--sky); }
  .caps h3 { margin: 0; font-size: clamp(1.2rem, 1.05rem + .5vw, 1.45rem); }
  .caps h3 a { color: inherit; text-decoration: none; }
  .caps h3 a:hover { text-decoration: underline; }
  .caps p { margin: 0; color: var(--muted); }
  .caps__who { font-size: .875rem; font-weight: 600; justify-self: end; text-align: right; }
  .caps__who a { color: var(--accent-text); }



  @media (max-width: 1023px) {
    .caps__row { grid-template-columns: 2.5rem minmax(0, 1fr); gap: .35rem 1rem; }
    .caps__row p, .caps__who { grid-column: 2; }
    .caps__who { justify-self: start; text-align: left; }
  }
</style>
