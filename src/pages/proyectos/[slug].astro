---
/** Plantilla de caso: Hero → Contexto → Oportunidad → Qué se construyó → Participación → Evidencia → Aprendizajes → CTA. */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import StatusLabel from '../../components/ui/StatusLabel.astro';
import DraftBanner from '../../components/ui/DraftBanner.astro';
import { SHOW_DRAFTS } from '../../lib/drafts';

export async function getStaticPaths() {
  const projects = await getCollection('proyectos', ({ data }) => data.hasCase && (data.published || SHOW_DRAFTS));
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isDraft = !d.published;
---
<BaseLayout
  title={d.seo?.title ?? d.name}
  description={d.seo?.description ?? d.shortDescription}
  noindex={isDraft}
>
  {isDraft && <DraftBanner>Este caso no aparece en producción hasta marcarlo como publicado.</DraftBanner>}
  <PageHero eyebrow={d.industry} title={d.name} breadcrumbs={[{ name: 'Proyectos', url: '/proyectos' }, { name: d.name, url: `/proyectos/${project.id}` }]}>
    <p>{d.shortDescription}</p>
    <div class="case-meta">
      {d.status && <StatusLabel tone="sky">{d.status}</StatusLabel>}
      {d.germanRole && <span class="case-role"><strong>Mi rol:</strong> {d.germanRole}</span>}
      {d.website && <a class="link-arrow" href={d.website} target="_blank" rel="noopener">Sitio del proyecto <span aria-hidden="true">↗</span><span class="sr-only">(abre en otra pestaña)</span></a>}
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="prose case-body"><Content /></div>
      {d.approvedMedia.length > 0 && (
        <div class="grid grid-2 mt-lg">
          {d.approvedMedia.map((m) => (
            <figure class="media"><Image src={m.src} alt={m.alt} widths={[600, 1000]} sizes="(min-width: 1024px) 600px, 100vw" loading="lazy" /></figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <CTABanner title="¿Tienes una oportunidad parecida? Platiquemos." ctaLabel="Platiquemos de tu oportunidad" ctaHref="/contacto" />
    </div>
  </section>
</BaseLayout>
<style>
  .case-meta { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 1.5rem; }
  .case-role { color: var(--muted-on-dark); font-size: .95rem; }
  .case-body :global(h2) { font-size: clamp(1.4rem, 1.2rem + .8vw, 1.8rem); }
  .case-body :global(h2:first-child) { margin-top: 0; }
  figure.media { margin: 0; }
</style>
