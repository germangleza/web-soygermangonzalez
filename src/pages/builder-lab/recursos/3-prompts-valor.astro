---
/**
 * Recurso gratuito: «3 prompts para vender beneficios, no características».
 * Se entrega por DM a quien comenta VALOR en el Reel. Sin registro: los prompts siempre visibles.
 * Copy y prompts en src/data/prompts-valor.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import CopyPromptCard from '../../../components/ui/CopyPromptCard.astro';
import { PAGE, VALUE_PROMPTS, RESOURCE_ID, RESOURCE_PATH } from '../../../data/prompts-valor';

const crumbs = [
  { name: 'Builder Lab', url: '/builder-lab' },
  { name: 'Recursos', url: '/builder-lab/recursos' },
  { name: '3 prompts de valor', url: RESOURCE_PATH },
];
---
<BaseLayout fullTitle={PAGE.seoTitle} description={PAGE.seoDescription}>
  <PageHero variant="lab" eyebrow={PAGE.eyebrow} title={PAGE.title} breadcrumbs={crumbs}>
    <p>{PAGE.subtitle}</p>
  </PageHero>

  <section class="section pv" aria-labelledby="pv-uso" data-resource-view={RESOURCE_ID}>
    <div class="container pv__wrap">
      <p class="pv__intro">{PAGE.intro}</p>

      <div class="pv__how" id="pv-uso">
        <p class="pv__how-title"><strong>{PAGE.instruction}</strong></p>
        <ol class="pv__steps" role="list">
          {PAGE.steps.map((s, i) => (
            <li><a href={`#prompt-${i + 1}-title`}><span class="pv__step-num">{i + 1}</span>{s}</a></li>
          ))}
        </ol>
      </div>

      <div class="pv__cards">
        {VALUE_PROMPTS.map((p) => (
          <CopyPromptCard number={p.number} label={p.label} title={p.title} description={p.description} prompt={p.content} resourceId={RESOURCE_ID} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="pv-final">
    <div class="container pv__wrap">
      <h2 id="pv-final">{PAGE.closingTitle}</h2>
      <p class="lead">{PAGE.closingText}</p>
      <p class="pv__note" role="note"><span aria-hidden="true">⚠</span> {PAGE.note}</p>
      <div class="actions">
        <a class="btn btn--dark" href="/builder-lab/recursos">Explorar más recursos <span class="btn__icon" aria-hidden="true">↗</span></a>
        <a class="btn btn--outline-dark" href="/contacto">Hablemos de tu negocio <span class="btn__icon" aria-hidden="true">↗</span></a>
      </div>
      <p class="pv__footer">{PAGE.footer}</p>
    </div>
  </section>

</BaseLayout>

<script>
  import { track } from '../../../scripts/analytics';
  const el = document.querySelector<HTMLElement>('[data-resource-view]');
  if (el) track('resource_view', { resource_id: el.dataset.resourceView ?? '' });
</script>

<style>
  .pv__wrap { max-width: 52rem; }
  .pv__intro { font-size: var(--fs-lead); line-height: 1.6; color: var(--navy); margin: 0 0 1.75rem; }
  .pv__how { border-left: 4px solid var(--lime, #c5ee66); background: #f3f6f9; border-radius: 0 var(--radius) var(--radius) 0; padding: 1.1rem 1.25rem; margin-bottom: 2.25rem; }
  .pv__how-title { margin: 0 0 .75rem; color: var(--navy); }
  .pv__steps { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .pv__steps li { display: flex; align-items: center; }
  .pv__steps li + li::before { content: '→'; color: var(--muted); margin-right: .5rem; }
  .pv__steps a { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .35rem .85rem .35rem .4rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-weight: 700; color: var(--navy); text-decoration: none; }
  .pv__steps a:hover { border-color: var(--navy); }
  .pv__step-num { display: inline-grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--navy); color: #fff; font-size: .85rem; }
  .pv__cards { display: grid; gap: 1.25rem; }
  .pv__cards :global(.cpc__title) { scroll-margin-top: calc(var(--header-h) + 24px); }
  .pv__note { margin: 1.25rem 0 0; padding: .9rem 1.1rem; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); color: var(--navy); }
  .pv__note span { color: var(--accent-text); margin-right: .25rem; }
  .pv__footer { margin: 2.5rem 0 0; font-size: .9rem; color: var(--muted); }
  @media (max-width: 479px) {
    .pv__steps { flex-direction: column; align-items: stretch; }
    .pv__steps li + li::before { content: none; }
    .pv__steps a { width: 100%; }
  }
</style>
