---
/** ReportForm: «Envíame mi resultado y recomendaciones». Email obligatorio; privacidad y marketing separados y sin premarcar. */
import Field from '../forms/Field.astro';
import FormMeta from '../forms/FormMeta.astro';
import Consent from '../forms/Consent.astro';
import ClinicLinksFields from '../diagnostic/ClinicLinksFields.astro';
const f = 'ckr';
---
<form class="form" data-lead-form id="form-ck-reporte" aria-labelledby="ck-report-title"
  data-success="¡Listo! Recibimos tu solicitud y te enviaremos tu resultado y recomendaciones por correo.">
  <FormMeta formType="checklist-ia-reporte" />
  <input type="hidden" name="answers" value="" data-ck-answers />
  <input type="hidden" name="business_type" value="" data-ck-business />
  <input type="hidden" name="city" value="" data-ck-city />
  <Field form={f} name="email" label="Correo electrónico" type="email" required autocomplete="email" maxlength={160} />
  <div class="form-row">
    <Field form={f} name="full_name" label="Nombre" autocomplete="name" maxlength={100} />
    <Field form={f} name="company" label="Empresa" autocomplete="organization" maxlength={150} />
  </div>
  <ClinicLinksFields form={f} legend="Tu negocio en internet" noWebsite={false} other
    hint="Solo si quieres que los consideremos. No te pediremos contraseñas ni accesos." />
  <Consent form={f} text="Acepto que usen mis datos para enviarme este resultado, conforme al" />
  <label class="check"><input type="checkbox" name="marketing_consent" value="true" /> <span>Quiero recibir consejos y novedades por correo. <span class="optional">(Opcional: tu resultado se envía aunque no lo marques.)</span></span></label>
  <div><button type="submit" class="btn btn--dark">Enviar mi reporte <span class="btn__icon" aria-hidden="true">↗</span></button></div>
  <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></div>
</form>
<script>
  import '../../scripts/forms';
</script>
