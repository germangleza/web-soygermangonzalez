---
/** ReviewForm + CommercialQualification: «Solicitar revisión de mi negocio» (commercial_fit_score interno). */
import Field from '../forms/Field.astro';
import FormMeta from '../forms/FormMeta.astro';
import Consent from '../forms/Consent.astro';
import ClinicLinksFields from '../diagnostic/ClinicLinksFields.astro';
import { BUSINESS_TYPES, COMMERCIAL } from '../../lib/checklist-ia/questions';
const f = 'ckv';
---
<form class="form" data-lead-form id="form-ck-revision" aria-labelledby="ck-review-title"
  data-success="¡Gracias! Recibimos tu solicitud. El equipo revisará tu caso y, si lo pediste, te contactará por correo.">
  <FormMeta formType="checklist-ia-revision" />
  <input type="hidden" name="answers" value="" data-ck-answers />
  <input type="hidden" name="city" value="" data-ck-city />
  <p class="small" style="margin:0">Todos los campos son obligatorios salvo los marcados como opcionales.</p>
  <div class="form-row">
    <Field form={f} name="full_name" label="Nombre" required autocomplete="name" minlength={2} maxlength={100} />
    <Field form={f} name="email" label="Correo electrónico" type="email" required autocomplete="email" maxlength={160} />
  </div>
  <Field form={f} name="company" label="Nombre comercial" required autocomplete="organization" minlength={2} maxlength={150} />

  <fieldset class="field cq">
    <legend>Unas preguntas breves</legend>
    <div class="form-row">
      <Field form={f} name="business_type" label="¿Qué tipo de negocio tienes?" as="select" required options={BUSINESS_TYPES} attrs={{ 'data-ck-business-select': '' }} />
      <Field form={f} name="objective" label={COMMERCIAL.objective.label} as="select" required options={COMMERCIAL.objective.options} />
    </div>
    <div class="form-row">
      <Field form={f} name="role" label={COMMERCIAL.role.label} as="select" required options={COMMERCIAL.role.options} />
      <Field form={f} name="start" label={COMMERCIAL.start.label} as="select" required options={COMMERCIAL.start.options} />
    </div>
    <Field form={f} name="budget" label={COMMERCIAL.budget.label} as="select" required options={COMMERCIAL.budget.options} />
    <div class="field">
      <span class="cq__label" id="ckv-wants-label">¿Deseas que el equipo te contacte para revisar el caso?</span>
      <div class="cq__radios" role="radiogroup" aria-labelledby="ckv-wants-label" aria-describedby="ckv-wants_contact-error">
        <label class="check"><input type="radio" name="wants_contact" value="si" required aria-describedby="ckv-wants_contact-error" /> <span>Sí</span></label>
        <label class="check"><input type="radio" name="wants_contact" value="no" /> <span>No, solo quiero la revisión por escrito</span></label>
      </div>
      <span id="ckv-wants_contact-error" class="field__error" aria-live="polite"></span>
    </div>
  </fieldset>

  <ClinicLinksFields form={f} legend="Tu negocio en internet" noWebsite={false} other
    hint="Opcional. No te pediremos contraseñas ni accesos." />
  <Consent form={f} text="Acepto que usen mis datos para atender esta solicitud de revisión, conforme al" />
  <label class="check"><input type="checkbox" name="marketing_consent" value="true" /> <span>Quiero recibir consejos y novedades por correo. <span class="optional">(Opcional)</span></span></label>
  <div><button type="submit" class="btn btn--lime">Solicitar revisión de mi negocio <span class="btn__icon" aria-hidden="true">↗</span></button></div>
  <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></div>
</form>
<script>
  import '../../scripts/forms';
</script>
<style>
  .cq { display: grid; gap: 1rem; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem; margin: 0; }
  .cq legend { padding: 0 .35rem; }
  .cq__label { font-size: .875rem; font-weight: 800; }
  .cq__radios { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .cq__radios .check { color: var(--ink); font-weight: 600; }
</style>
