---
/**
 * QuizStepper: contexto mínimo + bloques de preguntas, con progreso y Atrás/Siguiente.
 * Por defecto arma el checklist de IA; otros checklists pasan sus bloques, preguntas, opciones y
 * los campos de contexto en el slot «context».
 */
import Field from '../forms/Field.astro';
import QuestionCard from './QuestionCard.astro';
import * as IA from '../../lib/checklist-ia/questions';
import type { Option } from '../../lib/checklist-ia/questions';

type Q = { id: string; block: string; text: string; hint: string; allowNA?: boolean };
interface Props {
  blocks?: { id: string; label: string }[];
  questions?: Q[];
  options?: Option[];
  contextTitle?: string;
}
const {
  blocks = IA.BLOCK_ORDER.map((id) => ({ id, label: IA.BLOCKS[id].label })),
  questions = IA.QUESTIONS,
  options,
  contextTitle = 'Primero, cuéntanos de tu negocio',
} = Astro.props;
const steps = 1 + blocks.length;
---
<form class="stepper" id="ck-quiz" novalidate aria-labelledby="ck-quiz-title">
  <h2 id="ck-quiz-title" class="sr-only">Checklist</h2>
  <div class="stepper__progress">
    <p class="stepper__count" data-ck-count>Paso 1 de {steps} · Tu negocio</p>
    <div class="stepper__bar" role="progressbar" aria-label="Avance del checklist" aria-valuemin="0" aria-valuemax={steps} aria-valuenow="1" data-ck-bar>
      <span data-ck-fill style={`width:${100 / steps}%`}></span>
    </div>
  </div>

  <section class="stepper__step" data-step="0" data-label="Tu negocio" aria-labelledby="ck-ctx-title">
    <h3 id="ck-ctx-title" class="stepper__title" tabindex="-1">{contextTitle}</h3>
    <p class="stepper__sub">No necesitas dar tu correo para ver el resultado.</p>
    <div class="stepper__ctx">
      <slot name="context">
      <Field form="ck" name="business_type" label="Tipo de negocio" as="select" required options={IA.BUSINESS_TYPES} />
      <div class="form-row">
        <Field form="ck" name="city" label="Ciudad" autocomplete="address-level2" maxlength={120} placeholder="Ej. Monterrey" />
        <Field form="ck" name="website_url" label="Sitio web" maxlength={300} placeholder="minegocio.com"
          attrs={{ 'data-link-kind': 'website', inputmode: 'url', autocapitalize: 'off', spellcheck: 'false' }} />
      </div>
      </slot>
    </div>
  </section>

  {blocks.map((b, i) => (
    <section class="stepper__step" data-step={i + 1} data-label={b.label} aria-labelledby={`ck-b-${b.id}`}>
      <h3 id={`ck-b-${b.id}`} class="stepper__title" tabindex="-1"><span class="stepper__letter">{String.fromCharCode(65 + i)}</span> {b.label}</h3>
      {questions.filter((q) => q.block === b.id).map((q) => <QuestionCard q={q} n={questions.indexOf(q) + 1} options={options} />)}
    </section>
  ))}

  <p class="stepper__error" role="alert" data-ck-error></p>
  <div class="stepper__nav">
    <button type="button" class="btn btn--outline-dark" data-ck-back disabled>← Atrás</button>
    <button type="submit" class="btn btn--dark" data-ck-next>Siguiente →</button>
  </div>
  <p class="sr-only" aria-live="polite" data-ck-live></p>
</form>
<noscript><p style="text-align:center;margin-top:1rem">El checklist necesita JavaScript para calcular tu resultado. Si prefieres, <a href="/contacto">escríbeme</a>.</p></noscript>

<style>
  .stepper { max-width: 46rem; margin-inline: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.25rem, .9rem + 2vw, 2.5rem); }
  .stepper__progress { margin-bottom: 1.75rem; }
  .stepper__count { font-size: .8125rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .5rem; }
  .stepper__bar { height: 8px; border-radius: 999px; background: #e3ebf1; overflow: hidden; }
  .stepper__bar span { display: block; height: 100%; background: var(--navy); border-radius: inherit; transition: width .35s cubic-bezier(.22,1,.36,1); }
  .stepper__step + .stepper__step { margin-top: 3rem; }
  :global(.js-ck) .stepper__step + .stepper__step { margin-top: 0; }
  .stepper__title { font-size: clamp(1.4rem, 1.15rem + 1vw, 1.9rem); margin-bottom: 1.5rem; outline: none; display: flex; align-items: center; gap: .75rem; }
  .stepper__letter { display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 8px; background: var(--lime); color: var(--navy); font-size: 1.1rem; flex: none; }
  .stepper__sub { color: var(--muted); margin: -.75rem 0 1.25rem; }
  .stepper__ctx { display: grid; gap: 1.15rem; }
  .stepper__error { color: var(--danger); font-weight: 700; font-size: .9375rem; margin: 1rem 0 0; }
  .stepper__error:empty { margin: 0; }
  .stepper__nav { display: flex; justify-content: space-between; gap: .75rem; margin-top: 1.75rem; }
  .stepper__nav .btn { flex: 1 1 0; max-width: 14rem; }
  .stepper__nav [data-ck-next] { margin-left: auto; }
</style>
