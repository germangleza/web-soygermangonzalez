---
/** PostCard: categoría, título, fecha, descripción, imagen opcional y enlace al artículo. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate } from '../../lib/format';
import StatusLabel from './StatusLabel.astro';
interface Props {
  title: string;
  description: string;
  category: string;
  categoryLabel: string;
  href?: string;
  date?: Date;
  image?: ImageMetadata;
  imageAlt?: string;
  hasVideo?: boolean;
  status?: string;
}
const { title, description, category, categoryLabel, href, date, image, imageAlt = '', hasVideo, status } = Astro.props;
---
<article class:list={['card', 'post-card', { 'card--link': href }]} data-category={category}>
  {image && (
    <div class="post-card__media">
      <Image src={image} alt={imageAlt} widths={[400, 800]} sizes="(min-width: 1024px) 380px, (min-width: 680px) 45vw, 100vw" loading="lazy" />
    </div>
  )}
  <span class="card__kicker">{categoryLabel}{hasVideo && ' · Video'}</span>
  <h3>{href ? <a class="card__title-link" href={href}>{title}</a> : title}</h3>
  <p>{description}</p>
  <div class="card__footer post-card__meta">
    {date && <time datetime={date.toISOString()} class="small">{formatDate(date)}</time>}
    {status && <StatusLabel>{status}</StatusLabel>}
  </div>
</article>
<style>
  .post-card__media { margin: calc(-1 * clamp(1.4rem, 1.1rem + 1vw, 2rem)); margin-bottom: 1.25rem; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius) var(--radius) 0 0; background: var(--navy-2); }
  .post-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .post-card__meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
</style>
