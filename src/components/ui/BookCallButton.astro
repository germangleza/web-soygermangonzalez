---
/** Botón «Agenda una llamada» → landing /llamada (ahí está el calendario). Se usa al cierre de las secciones de la home. */
import { CALL_PATH } from '../../data/llamada';
interface Props { variant?: string; label?: string; }
const { variant = '', label = 'Agenda una llamada sin costo' } = Astro.props;
---
<a class:list={['btn', variant]} href={CALL_PATH}>
  {label} <span class="btn__icon" aria-hidden="true">↗︎</span>
</a>
