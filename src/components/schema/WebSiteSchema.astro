---
/** JSON-LD de WebSite. Incluir una vez por sitio. */
import { SITE } from '../../config/site.config';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: SITE.lang,
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
