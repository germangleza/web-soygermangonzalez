---
/** H04 — MethodSteps: Opportunity Building (Detectar · Diseñar · Activar · Construir). */
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { METHOD } from '../../data/content';
---
<section class="section section--dark dark" id="metodo" aria-labelledby="metodo-title">
  <div class="container">
    <SectionHeading id="metodo-title" eyebrow="Mi método" title="Opportunity Building">
      <p class="lead">Las oportunidades no se aprovechan solas. Hay que detectarlas, diseñarlas y construirlas.</p>
    </SectionHeading>
    <ol class="grid grid-4 steps" role="list">
      {METHOD.map((s) => (
        <li class="step">
          <div class="step__media">
            <Image src={s.image} alt={s.alt} widths={[320, 560]} sizes="(min-width: 1024px) 280px, (min-width: 680px) 45vw, 100vw" loading="lazy" />
          </div>
          <span class="step__num">{s.num} <span class="step__key">{s.key}</span></span>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; padding: 0; counter-reset: none; }
  .step { position: relative; border-top: 1px solid var(--line-dark); padding-top: 1.25rem; }
  .step__media { aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; margin-bottom: 1.25rem; background: var(--navy-2); }
  .step__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .step:hover .step__media img { transform: scale(1.04); }
  .step__num { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--sky); letter-spacing: 0.02em; margin-bottom: .5rem; }
  .step__key { color: #fff; letter-spacing: .12em; }
  .step__text { font-weight: 400; font-size: clamp(1.1rem, 1rem + .4vw, 1.3rem); line-height: 1.4; color: #fff !important; margin: 0; }
  @media (max-width: 679px) {
    .step { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 0 1rem; align-items: start; }
    .step__media { grid-row: span 2; margin: 0; }
  }
</style>
