---
/** H01 — HeroSection de la home. Imagen arquitectónica provisional del deck. */
import { Image } from 'astro:assets';
import hero from '../../assets/photos/hero-escalera.png';
---
<section class="hero dark" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Image src={hero} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 70vw, 100vw" loading="eager" fetchpriority="high" quality={70} />
  </div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">Germán González · Business Builder</span>
      <h1 id="hero-title">Te ayudo a hacer crecer el negocio que ya tienes.</h1>
      <p class="hero__lead">Un solo responsable, un equipo detrás y entregables en semanas: estrategia, marketing e IA trabajando para tu negocio, sin que tengas que coordinar a nadie.</p>
      <div class="actions">
        <a class="btn" href="/llamada">Agenda una llamada sin costo <span class="btn__icon" aria-hidden="true">↗</span></a>
        <a class="btn btn--outline" href="#metodo">Explora cómo trabajo <span class="btn__icon" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; overflow: hidden; background: var(--navy); isolation: isolate; }
  .hero__media { position: absolute; inset: 0 0 0 auto; width: 72%; z-index: -2; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, var(--navy) 0%, var(--navy) 30%, rgba(7,25,43,.85) 48%, rgba(7,25,43,.2) 100%);
  }
  .hero__inner { min-height: min(86vh, 720px); display: flex; align-items: center; padding-block: clamp(4rem, 3rem + 5vw, 7rem); }
  .hero__copy { max-width: 58rem; }
  .hero h1 { max-width: 18ch; font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem); }
  .hero__lead { font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem); color: #dce8f1 !important; max-width: 38rem; margin-top: 1.75rem; }
  @media (max-width: 1023px) {
    .hero__media { width: 100%; }
    .hero::before { background: linear-gradient(90deg, rgba(7,25,43,.97) 0%, rgba(7,25,43,.75) 100%); }
  }
  @media (max-width: 679px) {
    .hero__media img { object-position: 62% center; }
    .hero::before { background: linear-gradient(180deg, rgba(7,25,43,.7) 0%, rgba(7,25,43,.9) 75%); }
    .hero__inner { min-height: auto; padding-block: 3.5rem 4rem; }
  }
</style>
