---
/** H06 — BuilderLabTeaser (UN solo bloque en la home): Builder Lab, nuevos negocios y todas las herramientas gratuitas. */
import { LAB_TOOLS } from '../../data/content';
---
<section class="section section--tight" aria-labelledby="lab-teaser-title">
  <div class="container">
    <div class="lab dark">
      <div class="lab__copy">
        <span class="eyebrow eyebrow--lime">Builder Lab</span>
        <h2 id="lab-teaser-title">Exploramos. Probamos. <span class="text-lime">Construimos.</span></h2>
        <p class="lead">La tecnología está cambiando lo que podemos crear, cómo trabajamos y la forma en que hacemos negocios. En Builder Lab comparto las herramientas que pruebo, lo que voy descubriendo y los aprendizajes de proyectos reales.</p>
        <p>¿Estás empezando o quieres lanzar un negocio nuevo? Aquí encuentras herramientas gratuitas, experimentos y aprendizajes para construirlo.</p>
        <a class="btn btn--lime" href="/builder-lab">Conoce Builder Lab <span class="btn__icon" aria-hidden="true">↗</span></a>
      </div>
      <div class="lab__tools-wrap">
        <h3 class="lab__tools-title">Herramientas gratuitas</h3>
        <ul class="lab__tools" role="list">
          {LAB_TOOLS.map((t) => (
            <li class="lab__tool">
              <span class="lab__tool-kicker">{t.kicker}</span>
              <a class="lab__tool-link" href={t.href}>{t.title}</a>
              <p>{t.text}</p>
              <span class="lab__tool-go" aria-hidden="true">Usar gratis ↗</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lab__rings" aria-hidden="true"></div>
    </div>
  </div>
</section>
<style>
  .lab {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; align-items: center;
    background: var(--navy-3); border-radius: var(--radius-lg); padding: clamp(2.25rem, 1.5rem + 4vw, 4.5rem);
  }
  .lab__copy { max-width: 48rem; }
  .lab__copy .btn { margin-top: 1rem; }
  .lab__tools-title { font-size: 1.1rem; letter-spacing: .02em; margin-bottom: 1rem; color: #fff; }
  .lab__tools { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .lab__tool { position: relative; display: flex; flex-direction: column; gap: .4rem; padding: 1.35rem 1.4rem; border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius); background: rgba(255,255,255,.04); transition: border-color .15s ease, background-color .15s ease; }
  .lab__tool:hover { border-color: var(--lime); background: rgba(255,255,255,.07); }
  .lab__tool-kicker { font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--sky); }
  .lab__tool-link { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; line-height: 1.25; color: #fff; text-decoration: none; }
  .lab__tool-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .lab__tool-link:focus-visible { outline: none; }
  .lab__tool:has(.lab__tool-link:focus-visible) { outline: 3px solid var(--lime); outline-offset: 2px; }
  .lab__tool p { margin: 0; font-size: .95rem; color: var(--muted-on-dark); }
  .lab__tool-go { margin-top: auto; padding-top: .5rem; font-weight: 700; font-size: .9rem; color: var(--lime); }
  @media (max-width: 679px) { .lab__tools { grid-template-columns: minmax(0, 1fr); } }
  .lab__rings {
    position: absolute; z-index: -1; width: 520px; aspect-ratio: 1; right: -200px; top: -160px; border-radius: 50%;
    border: 1px solid #2f5170; opacity: .5;
    box-shadow: 0 0 0 70px transparent, 0 0 0 71px #284963, 0 0 0 140px transparent, 0 0 0 141px #22415a;
  }
</style>
