---
/** Home — Qué construimos y con quién (capacidades consolidadas con el equipo): Germán (estrategia) + empresas de ejecución. */
import SectionHeading from '../ui/SectionHeading.astro';
import { HOME_TEAM } from '../../data/content';
---
<section class="section" id="equipo" aria-labelledby="equipo-title">
  <div class="container">
    <SectionHeading id="equipo-title" eyebrow="Qué construimos y con quién" title="Tú hablas con una persona. Detrás trabaja el equipo completo.">
      <p class="lead">No todos los proyectos necesitan las mismas capacidades. Yo dirijo la estrategia y activo lo que pide la oportunidad con mis empresas.</p>
    </SectionHeading>
    <ul class="grid grid-3 team" role="list">
      {HOME_TEAM.map((t, i) => (
        <li class:list={['card', { 'card--dark': i === 0 }]}>
          <span class="card__kicker">{t.area}</span>
          <h3>{'url' in t && t.url ? (
            <a class="team__link" href={t.url} target="_blank" rel="noopener">{t.name} <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a>
          ) : t.name}</h3>
          <ul class="team__items" role="list">{t.items.map((c) => <li>{c}</li>)}</ul>
        </li>
      ))}
    </ul>
    <div class="team__foot">
      <p class="team__note"><span aria-hidden="true">+</span> <strong>Alianzas y nuevos canales:</strong> cuando el proyecto lo pide, sumo socios comerciales y aliados estratégicos.</p>
      <a class="btn btn--dark" href="/que-hago">Conoce cómo puedo ayudarte <span class="btn__icon" aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
  .team { list-style: none; padding: 0; }
  .team h3 { font-size: clamp(1.35rem, 1.15rem + .7vw, 1.75rem); }
  .team li.card { display: flex; flex-direction: column; }
  .team__link { color: inherit; text-decoration: none; }
  .team__link span[aria-hidden] { color: var(--accent-text); font-size: .8em; }
  .team__link:hover { text-decoration: underline; text-underline-offset: .2em; }
  .team__items { list-style: none; padding: 0; margin: .5rem 0 0; display: grid; gap: .6rem; }
  .team__items li { position: relative; padding-left: 1.4rem; color: var(--muted); line-height: 1.45; }
  .team__items li::before { content: ''; position: absolute; left: 0; top: .6em; width: .45rem; height: .45rem; border-radius: 50%; background: var(--sky); }
  .team .card--dark .team__items li { color: var(--muted-on-dark); }
  .team__foot { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; align-items: center; justify-content: space-between; }
  .team__note { margin: 0; color: var(--muted); font-size: .95rem; }
  .team__note span { color: var(--sky); font-weight: 700; margin-right: .35rem; }
</style>
