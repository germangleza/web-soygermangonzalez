---
/** H03 — CapabilityGrid. */
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { CAPABILITIES } from '../../data/content';
import bridge from '../../assets/photos/puente-oportunidad.png';
---
<section class="section section--alt" id="capacidades" aria-labelledby="capacidades-title">
  <div class="container">
    <div class="cap-head">
      <SectionHeading id="capacidades-title" eyebrow="Qué construimos" title="De una necesidad a algo construido.">
        <p class="lead">No todos los proyectos necesitan las mismas capacidades. La oportunidad define qué activamos.</p>
      </SectionHeading>
      <div class="media cap-media">
        <Image src={bridge} alt="Maqueta de un puente que une dos lados de una grieta, rodeado de bocetos y piezas" widths={[360, 650]} sizes="(min-width: 1024px) 340px, 0px" loading="lazy" />
      </div>
    </div>
    <ul class="cap-tags" role="list">
      {CAPABILITIES.map((c, i) => (
        <li><span class="cap-tags__num">{String(i + 1).padStart(2, '0')}</span>{c.title}</li>
      ))}
    </ul>
    <a class="btn btn--dark cap-cta" href="/que-hago">Conoce cómo puedo ayudarte <span class="btn__icon" aria-hidden="true">↗</span></a>
  </div>
</section>
<style>
  .cap-head { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; align-items: end; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .cap-head :global(.section-heading) { margin-bottom: 0; }
  .cap-media { aspect-ratio: 4 / 3; }
  .cap-tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .75rem; }
  .cap-tags li { display: inline-flex; align-items: baseline; gap: .6rem; padding: .85rem 1.35rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, .95rem + .45vw, 1.35rem); letter-spacing: -0.01em; color: var(--navy); }
  .cap-tags__num { font-size: .8em; color: var(--sky-700, #2f6fa3); }
  .cap-cta { margin-top: 2rem; }
  @media (max-width: 1023px) { .cap-head { grid-template-columns: minmax(0, 1fr); } .cap-media { display: none; } }
</style>
