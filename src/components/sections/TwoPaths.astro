---
/** H02 — Punto de partida: los problemas de un negocio en marcha. Quien empieza desde cero va a Builder Lab. */
import { HOME_START as p } from '../../data/content';
---
<section class="section" aria-labelledby="puertas-title">
  <div class="container">
    <article class="card start">
      <div class="start__head">
        <span class="card__kicker">{p.kicker}</span>
        <h2 id="puertas-title">{p.title}</h2>
      </div>
      <div>
        <p class="start__label">Te va a servir si…</p>
        <ul class="start__signals" role="list">{p.signals.map((s) => <li>{s}</li>)}</ul>
        <a class="link-arrow" href={p.cta.href}>{p.cta.label} <span aria-hidden="true">↗</span></a>
      </div>
    </article>
    <p class="paths-lab">¿Estás empezando desde cero o tienes una idea por validar? <a href="/builder-lab#lanzar">En Builder Lab te ayudo a construirla <span aria-hidden="true">↗</span></a></p>
  </div>
</section>
<style>
  .start { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 2rem 3rem; }
  .start h2 { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem); margin: 0; }
  .start__label { font-family: var(--font-display); font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .75rem; }
  .start__signals { list-style: none; padding: 0; margin: 0 0 1.75rem; display: grid; gap: .6rem; }
  .start__signals li { position: relative; padding-left: 1.6rem; color: var(--muted); }
  .start__signals li::before { content: '✓'; position: absolute; left: 0; color: var(--sky); font-weight: 700; }
  .paths-lab { margin: 1.75rem 0 0; color: var(--muted); max-width: 44rem; }
  .paths-lab a { color: var(--accent-text); font-weight: 700; }
  @media (max-width: 1023px) { .start { grid-template-columns: minmax(0, 1fr); } }
</style>
