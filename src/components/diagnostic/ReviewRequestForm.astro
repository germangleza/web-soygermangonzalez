---
/**
 * CTA B — "Quiero que revisen mi clínica" (spec §7–§8).
 * Incluye la calificación comercial interna (CommercialQualification); su puntuación nunca se muestra.
 */
import Field from '../forms/Field.astro';
import FormMeta from '../forms/FormMeta.astro';
import Consent from '../forms/Consent.astro';
import ClinicLinksFields from './ClinicLinksFields.astro';
import { QUALIFICATION, SPECIALTIES } from '../../lib/diagnostic/questions';
const f = 'dxv';
---
<form class="form" data-lead-form id="form-dx-revision" aria-labelledby="dx-review-title"
  data-success="¡Gracias! Recibimos tu solicitud. El equipo de Maguey Studio Salud revisará tu caso y te contactará por correo.">
  <FormMeta formType="diagnostico-revision" />
  <input type="hidden" name="answers" value="" data-dx-answers />
  <p class="small" style="margin:0">Todos los campos son obligatorios salvo los marcados como opcionales.</p>
  <div class="form-row">
    <Field form={f} name="full_name" label="Nombre completo" required autocomplete="name" minlength={2} maxlength={100} />
    <Field form={f} name="email" label="Correo electrónico" type="email" required autocomplete="email" maxlength={160} />
  </div>
  <div class="form-row">
    <Field form={f} name="clinic_name" label="Nombre de la clínica" required autocomplete="organization" minlength={2} maxlength={150} />
    <Field form={f} name="city" label="Ciudad y estado" required autocomplete="address-level2" minlength={2} maxlength={120} />
  </div>
  <Field form={f} name="specialty" label="Tipo de clínica" as="select" required options={SPECIALTIES} />
  <Field form={f} name="challenge" label="¿Qué te gustaría mejorar?" as="textarea" rows={3} required minlength={10} maxlength={2000}
    hint="En pocas líneas: tu reto principal. No incluyas datos de pacientes." />

  <fieldset class="field qual">
    <legend>Para preparar la revisión</legend>
    <div class="form-row">
      <Field form={f} name="role" label={QUALIFICATION.role.label} as="select" required options={QUALIFICATION.role.options} />
      <Field form={f} name="priority" label={QUALIFICATION.priority.label} as="select" required options={QUALIFICATION.priority.options} />
    </div>
    <div class="form-row">
      <Field form={f} name="start" label={QUALIFICATION.start.label} as="select" required options={QUALIFICATION.start.options} />
      <Field form={f} name="authorizer" label={QUALIFICATION.authorizer.label} as="select" required options={QUALIFICATION.authorizer.options} />
    </div>
    <Field form={f} name="investment" label={QUALIFICATION.investment.label} as="select" required options={QUALIFICATION.investment.options} />
  </fieldset>

  <ClinicLinksFields form={f} whatsapp />
  <Consent form={f} text="Acepto que Germán González y Maguey Studio Salud usen estos datos para revisar mi clínica y contactarme sobre esta solicitud, conforme al" />
  <label class="check"><input type="checkbox" name="marketing_consent" value="true" /> <span>También quiero recibir ideas y recursos por correo. <span class="optional">(Opcional)</span></span></label>
  <div><button type="submit" class="btn btn--lime">Solicitar revisión personalizada <span class="btn__icon" aria-hidden="true">↗</span></button></div>
  <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></div>
</form>
<script>
  import '../../scripts/forms';
</script>
<style>
  .qual { display: grid; gap: 1rem; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem; margin: 0; }
  .qual legend { padding: 0 .35rem; }
</style>
