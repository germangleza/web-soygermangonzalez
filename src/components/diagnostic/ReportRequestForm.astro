---
/** CTA A — "Envíame mi reporte" (spec §7). Solo el email es obligatorio. Marketing: check aparte y opcional. */
import Field from '../forms/Field.astro';
import FormMeta from '../forms/FormMeta.astro';
import Consent from '../forms/Consent.astro';
import ClinicLinksFields from './ClinicLinksFields.astro';
import { SPECIALTIES } from '../../lib/diagnostic/questions';
const f = 'dxr';
---
<form class="form" data-lead-form id="form-dx-reporte" aria-labelledby="dx-report-title"
  data-success="¡Listo! Recibimos tu solicitud y te enviaremos el reporte con tus recomendaciones a tu correo.">
  <FormMeta formType="diagnostico-reporte" />
  <input type="hidden" name="answers" value="" data-dx-answers />
  <Field form={f} name="email" label="Correo electrónico" type="email" required autocomplete="email" maxlength={160} />
  <div class="form-row">
    <Field form={f} name="full_name" label="Nombre" autocomplete="name" maxlength={100} />
    <Field form={f} name="clinic_name" label="Nombre de la clínica" autocomplete="organization" maxlength={150} />
  </div>
  <div class="form-row">
    <Field form={f} name="city" label="Ciudad y estado" autocomplete="address-level2" maxlength={120} placeholder="Ej. Monterrey, N.L." />
    <Field form={f} name="specialty" label="Especialidad" as="select" options={SPECIALTIES} />
  </div>
  <ClinicLinksFields form={f} />
  <Consent form={f} text="Acepto que usen mis datos para enviarme este reporte, conforme al" />
  <label class="check"><input type="checkbox" name="marketing_consent" value="true" /> <span>También quiero recibir ideas y recursos de Germán González por correo. <span class="optional">(Opcional: el reporte se envía aunque no lo marques.)</span></span></label>
  <div><button type="submit" class="btn btn--dark">Enviar mi reporte <span class="btn__icon" aria-hidden="true">↗</span></button></div>
  <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></div>
</form>
<script>
  import '../../scripts/forms';
</script>
