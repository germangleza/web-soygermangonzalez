---
/** Layout base: HTML semántico + SEO + schemas globales + header/footer. Todas las páginas lo usan. */
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import PersonSchema from '../components/schema/PersonSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { SITE } from '../config/site.config';

interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** Landing sin distracciones: header solo con logo y footer sin navegación. */
  minimal?: boolean;
}
const { minimal = false, ...props } = Astro.props;
const ga = SITE.analytics.googleAnalyticsId;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${SITE.blog.title}`} href="/rss.xml" />
    {SITE.fonts.adobeKitId && (
      <>
        <link rel="preconnect" href="https://use.typekit.net" crossorigin />
        <link rel="stylesheet" href={`https://use.typekit.net/${SITE.fonts.adobeKitId}.css`} />
      </>
    )}
    <SEO {...props} />
    <PersonSchema />
    <WebSiteSchema />
    {SITE.analytics.plausibleDomain && (
      <script defer data-domain={SITE.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader minimal={minimal} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SiteFooter minimal={minimal} />
    <script>
      import { captureAttribution } from '../scripts/analytics';
      import '../scripts/motion';
      captureAttribution();
    </script>
  </body>
</html>
